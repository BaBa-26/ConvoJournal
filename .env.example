# Copy this to .env — NEVER commit .env to git

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# DATABASE_URL = pooled connection string · DIRECT_URL = unpooled (migrations)
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
# Your app URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (add when ready to enable sign-in) ──────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Authorized redirect URIs:
#    dev:  http://localhost:3000/api/auth/callback/google
#    prod: https://<your-domain>/api/auth/callback/google
# Leave blank to disable Google sign-in (dev login still works in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI services ──────────────────────────────────────────────────────────────
# Groq Whisper transcription — https://console.groq.com
GROQ_API_KEY=
# Gemini 2.5 Flash journal analysis — AI Studio key (aistudio.google.com), not Vertex
GEMINI_API_KEY=
# Set to "true" to log the full Gemini prompt/response locally (optional)
# GEMINI_DEBUG=

# ── Durable rate limiting (optional — Upstash Redis, free tier) ───────────────
# Makes the /api/transcribe + /api/analyze rate limits global across serverless
# instances. Leave blank to fall back to per-instance in-memory limits only.
# The Vercel Marketplace integration injects these as KV_REST_API_URL /
# KV_REST_API_TOKEN instead — middleware.ts accepts either naming.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web-push notifications (optional — leave blank to keep push dormant) ──────
# Generate the keypair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Client reads this — must equal VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact URI for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Random secret; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# ── Billing (Stripe) ───────────────────────────────────────────────────────────
# Secret key — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price IDs from the Stripe dashboard (Product catalog)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Optional one-time price id; leave blank to hide the lifetime plan
STRIPE_PRICE_LIFETIME=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Free-tier weekly cap on /api/analyze calls (signed-in, non-premium users)
FREE_WEEKLY_ANALYSIS_LIMIT=3
