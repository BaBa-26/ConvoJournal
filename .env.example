# Copy this to .env — NEVER commit .env to git

# ── Database ─────────────────────────────────────────────────────────────────
# For local dev: use your Neon connection string (pooled) for DATABASE_URL
# and the unpooled one for DIRECT_URL
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# ── OpenAI — used ONLY for Whisper voice transcription ───────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
# Your app URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (add when ready to enable sign-in) ──────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# Leave blank to disable Google sign-in (dev login still works in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
