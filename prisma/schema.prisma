generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth required models ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime       @default(now())
  onboarded      Boolean        @default(false)
  displayName    String?
  journalMode    String?        // "voice" | "text" | "both"
  // ─── Dashboard personalization ───────────────────────────────────────────
  accentColor    String?        // hex preset, e.g. "#c8a878"; null = default gold
  typeScale      String   @default("md")       // "sm" | "md" | "lg"
  reminderTime   String?        // "HH:mm" 24h — daily goal/reflection nudge time (local)
  timezone       String?        // IANA tz (e.g. "Europe/London") captured when push is enabled; used to fire the daily nudge at the user's local reminderTime
  lastGoalNudge  DateTime?      // when the daily goal nudge last fired — prevents duplicate nudges within a day
  themeLayout    String   @default("daybreak")  // "daybreak" | "hearth" | "mosaic"
  colorMode      String   @default("dark")      // "light" | "dark" — only meaningful for daybreak
  widgetOrder    String[] @default(["tonight", "agenda", "stats", "streak", "tomorrow", "recent"])
  hiddenWidgets  String[] @default([])
  backgroundImage String?       // "preset:<key>" token or an uploaded data URL; null = none
  surfaceStyle    String   @default("solid")  // "solid" | "translucent" — widget card look
  accounts       Account[]
  sessions       Session[]
  entries        JournalEntry[]
  tasks          Task[]
  reminders      Reminder[]
  goals          Goal[]
  completions    Completion[]
  pushSubscriptions PushSubscription[]
}

// One row per browser/device a user has enabled notifications on. `endpoint` is the unique
// push address the browser hands us; `p256dh`/`auth` are the keys web-push needs to encrypt
// the payload so only that device can read it.
model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── App models ───────────────────────────────────────────────────────────────

model JournalEntry {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  date       DateTime
  rawContent String
  yesterday  String?
  today      String?
  tomorrow   String?
  mood       String?
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  reminders  Reminder[]

  @@unique([userId, date])
  @@index([userId])
}

model Task {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean       @default(false)
  completedAt    DateTime?     // when `completed` last flipped true — drives the 24h active-view hide + is Phase 5's raw material (updatedAt is unreliable: any edit bumps it). NEVER deleted.
  progress       Int           @default(0)   // 0–100; reaches 100 when completed
  priority       String        @default("medium")
  source         String        @default("journal")
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, completedAt]) // completion-ratio / momentum queries (Phase 5) group on completedAt
  @@index([journalEntryId])
}

model Goal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  unit      String   @default("times") // free-form counting unit: "days" | "sessions" | "times" | "pages" | …
  target    Int      // e.g. 7 (gym every day this week)
  current   Int      @default(0) // progress toward target; may be edited manually or by journal extraction
  step      Int      @default(1) // per-goal default increment the ± buttons apply (e.g. +10 for a reading goal)
  period    String   @default("week") // "week" | "month" | "ongoing"
  startDate DateTime @default(now())
  completed Boolean  @default(false)
  completedAt DateTime? // when `completed` last flipped true — drives the 24h auto-cleanup
  source    String   @default("manual") // "manual" | "journal"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A tiny, durable record of a finished task/goal. Written when an item completes and
// kept after the heavy Task/Goal row is auto-deleted (24h post-completion), so the
// weekly "momentum" bar can still credit wins the user already cleared. Pruned by the
// cleanup cron after ~60 days (only recent windows feed the bar).
model Completion {
  id          String   @id @default(cuid())
  kind        String   // "task" | "goal"
  title       String
  completedAt DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model Reminder {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  title          String
  description    String?
  eventDate      DateTime
  reminded       Boolean       @default(false)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([journalEntryId])
}
